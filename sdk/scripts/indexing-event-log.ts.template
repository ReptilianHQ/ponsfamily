export interface ProtocolEvent {
  chainId: number;
  srcAddress: string;
  logIndex: number;
  params: unknown;
  block: { number: number; hash: string; timestamp: number };
  transaction: { hash: string; transactionIndex: number };
}

export function chainKey(chainId: number, value: string): string {
  return `${chainId}:${value.toLowerCase()}`;
}

export function normalizedEvent(event: ProtocolEvent, contract: string, kind: string, signature: string) {
  return {
    id: `${event.chainId}:${event.block.hash.toLowerCase()}:${event.logIndex}`,
    chainId: BigInt(event.chainId),
    contract, kind, signature,
    sourceAddress: event.srcAddress.toLowerCase(),
    transactionHash: event.transaction.hash.toLowerCase(),
    transactionIndex: BigInt(event.transaction.transactionIndex),
    blockNumber: BigInt(event.block.number),
    blockHash: event.block.hash.toLowerCase(),
    blockTimestamp: BigInt(event.block.timestamp),
    logIndex: BigInt(event.logIndex),
    payload: JSON.stringify(event.params, (_key, value) => typeof value === 'bigint' ? value.toString() : value),
  };
}
